<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP is allowed: the panel's own asset host is http (answered inside the app, never on the network), and
     a web page that the Custom HTML widget shows by address is often plain http on a home network, at an address only
     the user knows (a Home Assistant server, a router, a camera). The app's own connections to the agent do not depend
     on this: AgentLink uses https with the agent's certificate pinned, over USB and over Wi-Fi. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
